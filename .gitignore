# macOS
.DS_Store

# shells / history
.zsh_history
.bash_history
.lesshst

# SSH keys (絶対に上げない)
.ssh/
!/.ssh/config
!/.ssh/config.d/

# secrets / env
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# editor / tooling caches
.vscode/
.idea/
*.swp
*.swo

# misc caches
.cache/

# tmux plugins (TPM が再生成。XDGパスで repo working tree 内に出来るため除外)
home/.config/tmux/plugins/

# herdr のランタイム生成物（config.toml だけ管理する）
home/.config/herdr/*
!home/.config/herdr/config.toml
